# Somente nomes de variaveis. Nunca coloque valores reais aqui. Veja scripts/gerar-env-dev.mjs.
# Papel do app em runtime (nexo_app, sem BYPASSRLS)
DATABASE_URL=
# Dono do banco: somente migrate, seed e setup de papeis (nunca usado pelo app em runtime)
DATABASE_MIGRATE_URL=
# Banco de testes de integracao (nexo_test) e seu dono
TEST_DATABASE_URL=
TEST_DATABASE_MIGRATE_URL=
# Senha do papel nexo_app, definida por scripts/db-migrar.mjs
APP_DB_PASSWORD=
# Senha dos usuarios de demonstracao do seed (somente DEV)
SEED_PASSWORD=
BETTER_AUTH_SECRET=
APP_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_TIMEZONE=America/Maceio
MAX_UPLOAD_MB=
# true somente atras de proxy reverso confiavel (x-forwarded-for). Padrao false.
TRUST_PROXY=false
# Tentativas de login por minuto e por IP (padrao 5; so suba em testes).
AUTH_SIGNIN_RATE_MAX=5
