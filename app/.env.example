# Somente nomes de variaveis. Nunca coloque valores reais aqui. Veja scripts/gerar-env-dev.mjs.
# Papel do app em runtime (nexo_app, sem BYPASSRLS)
DATABASE_URL=
# Dono do banco: somente migrate, seed e setup de papeis (nunca usado pelo app em runtime)
DATABASE_MIGRATE_URL=
# Banco de testes de integracao (nexo_test) e seu dono
TEST_DATABASE_URL=
TEST_DATABASE_MIGRATE_URL=
# Senha do papel nexo_app, definida por scripts/db-migrar.mjs
APP_DB_PASSWORD=
# Senha dos usuarios de demonstracao do seed (somente DEV)
SEED_PASSWORD=
BETTER_AUTH_SECRET=
APP_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_TIMEZONE=America/Maceio
MAX_UPLOAD_MB=
# Obrigatoria em producao (o app nao inicia sem ela). true so atras de proxy reverso confiavel; false = acesso direto.
# Veja docs/proxy-e-ip.md. Fora de producao o padrao e false.
TRUST_PROXY=false
# Cabecalho com o IP do cliente que so o proxy define (padrao x-real-ip; Cloudflare: cf-connecting-ip).
TRUSTED_IP_HEADER=x-real-ip
# IPs/CIDRs dos proxies proprios, separados por virgula (so para cabecalho com cadeia, como x-forwarded-for).
TRUSTED_PROXIES=
# Tentativas de login por minuto e por IP (padrao 5; so suba em testes).
AUTH_SIGNIN_RATE_MAX=5
# Falhas de login por (e-mail, IP) em 15 minutos (padrao 10; zera quando o login da certo).
AUTH_SIGNIN_EMAIL_MAX=10
# Teto de falhas por e-mail em 15 minutos, de qualquer IP (padrao 100; so contra ataque distribuido).
AUTH_SIGNIN_EMAIL_GLOBAL_MAX=100
# Somente para scripts/provisionar-producao.mjs (docs/runbook-producao.md); NAO fazem parte do app em runtime.
# Exporte no terminal, nunca grave valores aqui: PROVISIONAR_HOST_PERMITIDO, ADMIN_NOME, ADMIN_EMAIL, ADMIN_SENHA
