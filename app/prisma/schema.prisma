// Schema do Nexo Digital (fase 1). As tabelas user/session/account/verification foram geradas
// pelo CLI do Better Auth 1.7.27 (`auth generate --adapter prisma`, plugin admin) e ajustadas:
// ids UUID, nomes em snake_case plural e enums. Ver contexto/DECISOES.md (D-0004, D-0005).
// Colunas de data sao timestamptz (UTC). Isolamento: client_id + RLS (migration 0001).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  ADMIN
  STAFF
  USER
}

// Preferencia de tema, gravada por usuario (migration 20261124200000).
enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Papel da pessoa dentro de um cliente. STAFF aqui significa "atribuido a este cliente".
enum MemberRole {
  STAFF
  CLIENT_OWNER
  CLIENT_COLLABORATOR
}

enum MemberStatus {
  ACTIVE
  REVOKED
}

// ---------- Better Auth (gerado) ----------

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  role          GlobalRole @default(USER)
  banned        Boolean    @default(false)
  banReason     String?    @map("ban_reason")
  banExpires    DateTime?  @map("ban_expires") @db.Timestamptz(3)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)
  themePreference ThemePreference @default(SYSTEM) @map("theme_preference")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  accounts            Account[]
  memberships         ClientMember[]
  invitationsSent     Invitation[]   @relation("InvitationInviter")
  invitationsAccepted Invitation[]   @relation("InvitationAccepter")
  auditLogs           AuditLog[]

  // Fase 2: autoria preservada (usuario nunca e apagado; ver D-0007).
  contentsAssigned    Content[]        @relation("ContentAssignee")
  versionsAuthored    ContentVersion[] @relation("VersionAuthor")
  approvalsGiven      Approval[]       @relation("ApprovalAuthor")
  commentsWritten     Comment[]        @relation("CommentAuthor")
  scriptsAssigned     Script[]         @relation("ScriptAssignee")
  recordingsSubmitted Recording[]      @relation("RecordingSubmitter")
  recordingsReviewed  Recording[]      @relation("RecordingReviewer")
  assetsUploaded      Asset[]          @relation("AssetUploader")

  @@unique([email])
  @@map("users")
}

model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  token          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id") @db.Uuid
  impersonatedBy String?  @map("impersonated_by")
  // Cliente ativo, gravado so pelo servidor apos conferir a participacao (nunca pelo navegador).
  activeClientId String?  @map("active_client_id") @db.Uuid

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeClient Client? @relation(fields: [activeClientId], references: [id], onDelete: SetNull)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

// A senha (hash scrypt do Better Auth) fica em account.password; nunca em users.
model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Usado pelo Better Auth para o token de redefinicao de senha (identifier guardado como hash
// com verification.storeIdentifier = "hashed"; uso unico via consumeVerificationValue).
model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Limite de tentativas do Better Auth com armazenamento em banco (rateLimit.storage = "database").
// A chave mistura IP e rota; a linha some quando a janela expira. Sem dados de cliente: sem RLS.
model RateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  count       Int
  lastRequest BigInt @map("last_request")

  @@unique([key])
  @@index([lastRequest])
  @@map("rate_limits")
}

// ---------- Dominio ----------

model Client {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  legalName     String?      @map("legal_name")
  slug          String
  contactName   String?      @map("contact_name")
  contactEmail  String?      @map("contact_email")
  timezone      String       @default("America/Maceio")
  status        ClientStatus @default(ACTIVE)
  brandSettings Json?        @map("brand_settings")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  members     ClientMember[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  sessions    Session[]

  // Fase 2 (todas com client_id obrigatorio e RLS forcada).
  subscriptions   Subscription[]
  cycles          EditorialCycle[]
  contents        Content[]
  contentVersions ContentVersion[]
  approvals       Approval[]
  comments        Comment[]
  scripts         Script[]
  scriptScenes    ScriptScene[]
  recordings      Recording[]
  assets          Asset[]
  assetLinks      AssetLink[]

  @@unique([slug])
  @@map("clients")
}

model ClientMember {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String       @map("client_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  role        MemberRole
  permissions String[]     @default([])
  status      MemberStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId, status])
  @@map("client_members")
}

// Convite de uso unico. O token em si nunca e gravado: so o hash SHA-256.
model Invitation {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String     @map("client_id") @db.Uuid
  email        String
  role         MemberRole
  tokenHash    String     @map("token_hash")
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?  @map("used_at") @db.Timestamptz(3)
  usedByUserId String?    @map("used_by_user_id") @db.Uuid
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(3)
  invitedById  String     @map("invited_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  usedBy    User?  @relation("InvitationAccepter", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@unique([tokenHash])
  @@index([clientId, email])
  @@index([clientId, expiresAt])
  @@map("invitations")
}

// Append-only: o papel do app nao tem UPDATE nem DELETE nesta tabela (migration 0001).
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String?  @map("client_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  requestId  String?  @map("request_id")
  // Diff sanitizado: nunca senha, token ou hash.
  diff       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =====================================================================================
// Fase 2: planos, ciclos, conteudos, aprovacao, roteiros e arquivos (migration 20261125100000).
// Toda tabela de cliente tem client_id obrigatorio, RLS forcada e FKs COMPOSTAS (client_id, id):
// o banco recusa ligar linha de um cliente a linha de outro. Ver contexto/DECISOES.md D-0010 a D-0014.
// =====================================================================================

enum Visibility {
  INTERNO
  COMPARTILHADO
}

enum SubscriptionStatus {
  ATIVA
  PAUSADA
  ENCERRADA
}

enum CycleStatus {
  ABERTO
  ENCERRADO
}

enum ContentFormat {
  ARTE
  CARROSSEL
  REEL_ANIMADO
  REEL_HUMANIZADO
  STORY
  OUTRO
}

enum Channel {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  LINKEDIN
  OUTRO
}

enum ContentStatus {
  PLANEJADO
  EM_PRODUCAO
  AGUARDANDO_APROVACAO
  EM_REVISAO
  APROVADO
  AGENDADO
  PUBLICADO
  ANALISADO
  CANCELADO
}

enum VersionStatus {
  RASCUNHO
  ENVIADA
}

enum ApprovalDecision {
  APROVADO
  REVISAO_SOLICITADA
}

enum ScriptStatus {
  RASCUNHO
  ENVIADO
  AGUARDANDO_GRAVACAO
  GRAVACAO_RECEBIDA
  EM_EDICAO
  AGUARDANDO_APROVACAO
  FINALIZADO
  PUBLICADO
}

enum RecordingKind {
  ARQUIVO
  LINK
}

enum RecordingStatus {
  ENVIADA
  RECEBIDA
  REGRAVACAO_SOLICITADA
}

enum AssetStatus {
  PENDENTE
  DISPONIVEL
  REJEITADO
  EXCLUIDO
}

enum ScanStatus {
  NAO_VERIFICADO
  LIMPO
  QUARENTENA
}

enum AssetCategory {
  IMAGEM
  VIDEO
  DOCUMENTO
}

enum AssetLinkRole {
  PREVIA
  FINAL
  REFERENCIA
  PDF_ROTEIRO
  GRAVACAO
  EVIDENCIA
}

// Catalogo da agencia: SEM client_id. Plano publicado nao e editado (so `active`); mudar = nova versao.
model ServicePlan {
  id                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                         String
  version                      Int
  name                         String
  monthlyAmountCents           Int      @map("monthly_amount_cents")
  monthlyQuota                 Int      @map("monthly_quota")
  revisionsPerPiece            Int      @map("revisions_per_piece")
  approvalDeadlineBusinessDays Int      @map("approval_deadline_business_days")
  scope                        String
  exclusions                   String   @default("")
  active                       Boolean  @default(true)
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@unique([code, version])
  @@map("service_plans")
}

// Retrato do plano no momento da contratacao: o portal le so isto, nunca o catalogo.
model Subscription {
  id                           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                     String             @map("client_id") @db.Uuid
  planId                       String             @map("plan_id") @db.Uuid
  planCode                     String             @map("plan_code")
  planName                     String             @map("plan_name")
  planVersion                  Int                @map("plan_version")
  scopeSnapshot                String             @map("scope_snapshot")
  exclusionsSnapshot           String             @default("") @map("exclusions_snapshot")
  amountCents                  Int                @map("amount_cents")
  quota                        Int
  revisionsPerPiece            Int                @map("revisions_per_piece")
  approvalDeadlineBusinessDays Int                @map("approval_deadline_business_days")
  startsOn                     DateTime           @map("starts_on") @db.Date
  endsOn                       DateTime?          @map("ends_on") @db.Date
  billingDay                   Int                @map("billing_day")
  status                       SubscriptionStatus @default(ATIVA)
  createdAt                    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  plan   ServicePlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  cycles EditorialCycle[]

  @@unique([clientId, id])
  @@index([clientId, status])
  @@index([planId])
  @@map("subscriptions")
}

model EditorialCycle {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String      @map("client_id") @db.Uuid
  subscriptionId    String      @map("subscription_id") @db.Uuid
  year              Int
  month             Int
  quota             Int
  previousQuota     Int?        @map("previous_quota")
  quotaChangeReason String?     @map("quota_change_reason")
  status            CycleStatus @default(ABERTO)
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz(3)
  // Retrato de fechamento: contadores finais e escopo vigente; as telas leem isto depois de encerrar.
  closeSnapshot     Json?       @map("close_snapshot")
  reopenedAt        DateTime?   @map("reopened_at") @db.Timestamptz(3)
  reopenReason      String?     @map("reopen_reason")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [clientId, subscriptionId], references: [clientId, id], onDelete: Restrict)
  contents     Content[]

  @@unique([subscriptionId, year, month])
  @@unique([clientId, id])
  @@index([clientId, year, month])
  @@index([clientId, status])
  @@map("editorial_cycles")
}

model Content {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                String        @map("client_id") @db.Uuid
  cycleId                 String        @map("cycle_id") @db.Uuid
  title                   String
  description             String?
  format                  ContentFormat
  channel                 Channel       @default(INSTAGRAM)
  objective               String?
  pillar                  String?
  // Data local do cliente (sem hora): o calendario do mes usa esta data.
  plannedOn               DateTime      @map("planned_on") @db.Date
  publishedAt             DateTime?     @map("published_at") @db.Timestamptz(3)
  publicationUrl          String?       @map("publication_url")
  assigneeId              String?       @map("assignee_id") @db.Uuid
  assigneeVisibleToClient Boolean       @default(false) @map("assignee_visible_to_client")
  status                  ContentStatus @default(PLANEJADO)
  visibility              Visibility    @default(INTERNO)
  countsTowardQuota       Boolean       @default(true) @map("counts_toward_quota")
  isBonus                 Boolean       @default(false) @map("is_bonus")
  currentVersionId        String?       @map("current_version_id") @db.Uuid
  internalNotes           String?       @map("internal_notes")
  cancelReason            String?       @map("cancel_reason")
  cancelledAt             DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  client         Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  cycle          EditorialCycle   @relation(fields: [clientId, cycleId], references: [clientId, id], onDelete: Restrict)
  assignee       User?            @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  currentVersion ContentVersion?  @relation("CurrentVersion", fields: [clientId, currentVersionId], references: [clientId, id], onDelete: Restrict)
  versions       ContentVersion[] @relation("VersionContent")
  approvals      Approval[]
  comments       Comment[]
  scripts        Script[]
  assetLinks     AssetLink[]

  @@unique([clientId, id])
  @@index([clientId, status])
  @@index([clientId, plannedOn])
  @@index([clientId, cycleId])
  @@map("contents")
}

// Versao ENVIADA e imutavel (gatilho). A "atual" e contents.current_version_id (um unico ponteiro).
model ContentVersion {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String        @map("client_id") @db.Uuid
  contentId String        @map("content_id") @db.Uuid
  number    Int
  status    VersionStatus @default(RASCUNHO)
  caption   String?
  cta       String?
  hashtags  String[]      @default([])
  briefing  String?
  authorId  String        @map("author_id") @db.Uuid
  sentAt    DateTime?     @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  content    Content     @relation("VersionContent", fields: [clientId, contentId], references: [clientId, id], onDelete: Restrict)
  author     User        @relation("VersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  currentOf  Content[]   @relation("CurrentVersion")
  approvals  Approval[]
  comments   Comment[]
  assetLinks AssetLink[]

  @@unique([contentId, number])
  @@unique([clientId, id])
  @@index([clientId, contentId])
  @@map("content_versions")
}

// Imutavel: sem DELETE; UPDATE so para invalidar (gatilhos). Uma decisao ativa por versao (indice parcial).
model Approval {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String           @map("client_id") @db.Uuid
  contentId          String           @map("content_id") @db.Uuid
  versionId          String           @map("version_id") @db.Uuid
  decision           ApprovalDecision
  comment            String?
  authorId           String           @map("author_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  invalidatedAt      DateTime?        @map("invalidated_at") @db.Timestamptz(3)
  invalidationReason String?          @map("invalidation_reason")

  client  Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  content Content        @relation(fields: [clientId, contentId], references: [clientId, id], onDelete: Restrict)
  version ContentVersion @relation(fields: [clientId, versionId], references: [clientId, id], onDelete: Restrict)
  author  User           @relation("ApprovalAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([clientId, contentId, createdAt])
  @@index([versionId])
  @@map("approvals")
}

// Imutavel (sem UPDATE nem DELETE). Exatamente um alvo: conteudo ou roteiro.
model Comment {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String     @map("client_id") @db.Uuid
  contentId  String?    @map("content_id") @db.Uuid
  scriptId   String?    @map("script_id") @db.Uuid
  versionId  String?    @map("version_id") @db.Uuid
  authorId   String     @map("author_id") @db.Uuid
  body       String
  visibility Visibility @default(INTERNO)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  client  Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  content Content?        @relation(fields: [clientId, contentId], references: [clientId, id], onDelete: Restrict)
  script  Script?         @relation(fields: [clientId, scriptId], references: [clientId, id], onDelete: Restrict)
  version ContentVersion? @relation(fields: [clientId, versionId], references: [clientId, id], onDelete: Restrict)
  author  User            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([clientId, contentId, createdAt])
  @@index([clientId, scriptId, createdAt])
  @@map("comments")
}

model Script {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId               String       @map("client_id") @db.Uuid
  contentId              String?      @map("content_id") @db.Uuid
  title                  String
  objective              String?
  plannedDurationSeconds Int?         @map("planned_duration_seconds")
  assigneeId             String?      @map("assignee_id") @db.Uuid
  deadlineOn             DateTime?    @map("deadline_on") @db.Date
  location               String?
  equipment              String?
  vertical916            Boolean      @default(true) @map("vertical_9_16")
  audioNotes             String?      @map("audio_notes")
  lightNotes             String?      @map("light_notes")
  framingNotes           String?      @map("framing_notes")
  referenceLinks         Json         @default("[]") @map("reference_links")
  checklist              Json         @default("[]")
  status                 ScriptStatus @default(RASCUNHO)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  content    Content?      @relation(fields: [clientId, contentId], references: [clientId, id], onDelete: Restrict)
  assignee   User?         @relation("ScriptAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  scenes     ScriptScene[]
  recordings Recording[]
  comments   Comment[]
  assetLinks AssetLink[]

  @@unique([clientId, id])
  @@index([clientId, status])
  @@index([clientId, contentId])
  @@map("scripts")
}

model ScriptScene {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  scriptId        String   @map("script_id") @db.Uuid
  position        Int
  dialogue        String?
  action          String?
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  script Script @relation(fields: [clientId, scriptId], references: [clientId, id], onDelete: Restrict)

  @@unique([scriptId, position])
  @@index([clientId, scriptId])
  @@map("script_scenes")
}

model Recording {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId               String          @map("client_id") @db.Uuid
  scriptId               String          @map("script_id") @db.Uuid
  kind                   RecordingKind
  // So https (CHECK no banco); validacao completa (SSRF, lista de dominios) no servico.
  externalUrl            String?         @map("external_url")
  status                 RecordingStatus @default(ENVIADA)
  submittedById          String          @map("submitted_by_id") @db.Uuid
  submittedAt            DateTime        @default(now()) @map("submitted_at") @db.Timestamptz(3)
  imageRightsConfirmedAt DateTime?       @map("image_rights_confirmed_at") @db.Timestamptz(3)
  // Justificativa do pedido de regravacao (visivel ao cliente).
  feedback               String?
  reviewedById           String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt             DateTime?       @map("reviewed_at") @db.Timestamptz(3)

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  script      Script      @relation(fields: [clientId, scriptId], references: [clientId, id], onDelete: Restrict)
  submittedBy User        @relation("RecordingSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("RecordingReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  assetLinks  AssetLink[]

  @@unique([clientId, id])
  @@index([clientId, scriptId, submittedAt])
  @@map("recordings")
}

model Asset {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String         @map("client_id") @db.Uuid
  // clients/<client_id>/<uuid aleatorio>: sem nome original, sem extensao (CHECK no banco).
  storageKey     String         @map("storage_key")
  mimeType       String?        @map("mime_type")
  category       AssetCategory?
  bytes          BigInt?
  checksumSha256 String?        @map("checksum_sha256")
  originalName   String         @map("original_name")
  uploadedById   String         @map("uploaded_by_id") @db.Uuid
  status         AssetStatus    @default(PENDENTE)
  // Pronto para quarentena futura (antivirus fora da fase 2): fica NAO_VERIFICADO.
  scanStatus     ScanStatus     @default(NAO_VERIFICADO) @map("scan_status")
  visibility     Visibility     @default(INTERNO)
  finalizedAt    DateTime?      @map("finalized_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  uploadedBy User        @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  links      AssetLink[]

  @@unique([storageKey])
  @@unique([clientId, id])
  @@index([clientId, status, createdAt])
  @@map("assets")
}

// Um arquivo, um destino tipado (CHECK de exatamente um), com FK composta por destino.
model AssetLink {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String        @map("client_id") @db.Uuid
  assetId     String        @map("asset_id") @db.Uuid
  versionId   String?       @map("version_id") @db.Uuid
  scriptId    String?       @map("script_id") @db.Uuid
  recordingId String?       @map("recording_id") @db.Uuid
  // Evidencia de publicacao: o destino e o conteudo.
  contentId   String?       @map("content_id") @db.Uuid
  role        AssetLinkRole
  position    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  asset     Asset           @relation(fields: [clientId, assetId], references: [clientId, id], onDelete: Restrict)
  version   ContentVersion? @relation(fields: [clientId, versionId], references: [clientId, id], onDelete: Restrict)
  script    Script?         @relation(fields: [clientId, scriptId], references: [clientId, id], onDelete: Restrict)
  recording Recording?      @relation(fields: [clientId, recordingId], references: [clientId, id], onDelete: Restrict)
  content   Content?        @relation(fields: [clientId, contentId], references: [clientId, id], onDelete: Restrict)

  @@unique([assetId, versionId])
  @@unique([assetId, scriptId])
  @@unique([assetId, recordingId])
  @@unique([assetId, contentId])
  @@unique([versionId, role, position])
  @@index([clientId, assetId])
  @@index([clientId, versionId])
  @@index([clientId, scriptId])
  @@index([clientId, recordingId])
  @@index([clientId, contentId])
  @@map("asset_links")
}

// Configuracao da instalacao (migration 20261125140000). Hoje so guarda `installation_id`, o identificador
// aleatorio que a limpeza de arquivos confere contra `.install-id` da pasta de armazenamento (M-A).
// O papel do app so le e cria, e so em escopo de sistema (RLS).
model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("app_settings")
}
