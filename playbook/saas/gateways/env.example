# Variáveis dos gateways de pagamento. Copie só as do gateway usado para o .env do servidor.
# Gerado a partir de gateways.json. Valores reais nunca entram no Git.
PAYMENT_CREDENTIALS_KEY=  # chave de 32 bytes em base64 para cifrar credenciais no banco
PAYMENT_ACTIVE_GATEWAY=   # greenn | asaas | stripe | pagarme | mercadopago | efi

# Greenn (cartao, pix, boleto)
GREENN_API_TOKEN=grn_live_  # Token de API (obrigatório)
GREENN_WEBHOOK_SECRET=  # Segredo extra na URL (opcional)
GREENN_WEBHOOK_TOKEN=  # Webhook Token (obrigatório; chega no header X-Webhook-Token)
GREENN_SELLER_ID=  # Seller ID (opcional)

# Asaas (pix, cartao, boleto)
ASAAS_API_KEY=$aact_hmlg_  # API Key (obrigatório)
ASAAS_WEBHOOK_TOKEN=  # Token do webhook (obrigatório)

# Stripe (cartao, pix, boleto)
STRIPE_SECRET_KEY=sk_test_  # Secret Key (ou Restricted Key) (obrigatório)
STRIPE_PUBLISHABLE_KEY=pk_test_  # Publishable Key (obrigatório)
STRIPE_WEBHOOK_SECRET=whsec_  # Webhook Secret (obrigatório)

# Pagar.me (cartao, pix, boleto)
PAGARME_SECRET_KEY=sk_test_  # Secret Key (obrigatório)
PAGARME_PUBLIC_KEY=pk_test_  # Public Key (opcional)
PAGARME_WEBHOOK_SECRET=  # Segredo da URL do webhook (obrigatório)

# Mercado Pago (pix, cartao, boleto)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-  # Access Token (obrigatório)
MERCADOPAGO_PUBLIC_KEY=APP_USR-  # Public Key (opcional)
MERCADOPAGO_WEBHOOK_SECRET=  # Assinatura secreta do webhook (obrigatório)
MERCADOPAGO_SANDBOX=true

# Efí (pix, cartao, boleto)
EFI_CLIENT_ID=  # Client ID (obrigatório)
EFI_CLIENT_SECRET=  # Client Secret (obrigatório)
EFI_CERT_P12_BASE64=  # Certificado .p12 (obrigatório para pix)
EFI_PIX_KEY=  # Chave Pix (obrigatório para pix)
EFI_ACCOUNT_ID=  # Identificador de conta (payee code) (obrigatório para cartao)
EFI_WEBHOOK_SECRET=  # Segredo HMAC do webhook (obrigatório)
EFI_SANDBOX=true
